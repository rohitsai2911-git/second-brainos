# ── Second Brain OS — Environment ─────────────────────────────
# Copy to .env and fill in values. All have sensible dev defaults.

# Security
# ENV=production refuses to boot unless JWT_SECRET is unique (>= 32 chars).
ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM provider (OpenAI-compatible). Leave key empty to use the
# built-in local fallback engine (extractive summaries, template
# flashcards, etc.) — great for offline dev / demos.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Embeddings (local sentence-transformers model, runs in backend)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Frontend → Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000
